<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>EggMapper</AssemblyName>
    <RootNamespace>EggMapper</RootNamespace>
    <PackageId>EggMapper</PackageId>
    <Version>1.14.0</Version>
    <Authors>Eggspot</Authors>
    <Company>Eggspot</Company>
    <Product>EggMapper</Product>
    <Description>Fast .NET object-to-object mapper with AutoMapper's API (CreateMap, ForMember, Profile, IMapper). Maps compile to expression trees on first use. Includes DI (AddEggMapper), IQueryable projection (ProjectTo), flattening, records, collections, configuration validation that names the fix, and llms.txt guidance for AI coding assistants. Benchmarks against AutoMapper, Mapster and Mapperly are in the README.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/eggspot/EggMapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eggspot/EggMapper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mapper;automapper;automapper-alternative;automapper-replacement;object-mapper;object-mapping;expression-trees;performance;mapping;dto;di;dependency-injection;ef-core;blazor;aspnet;model-mapping;fast-mapper;mapster-alternative;csharp;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright © Eggspot</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <TargetFrameworks>netstandard2.0;net462;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EggMapper.UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\..\assets\icon.png')" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="2.1.0" />
  </ItemGroup>
</Project>

